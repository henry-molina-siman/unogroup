# unogroup-app/k8s/overlays/local/secret-patch.yaml.example
#
# Copia este archivo a `secret-patch.yaml` (mismo directorio) y reemplaza
# los valores por credenciales reales de Solution One para tu entorno local.
#
# `secret-patch.yaml` está en .gitignore a propósito: nunca se commitea.
# Sin este patch, `kubectl apply -k` reconcilia base/secret.yaml (que trae
# CHANGE_ME) sobre cualquier valor que hayas puesto a mano con
# `kubectl create secret`, y la app vuelve a fallar con 401 contra
# Solution One en el próximo apply/rollout.
apiVersion: v1
kind: Secret
metadata:
  name: unogroup-app-solutionone-secret
type: Opaque
stringData:
  SOLUTIONONE_USUARIO: "CHANGE_ME"
  SOLUTIONONE_PASSWORD: "CHANGE_ME"
